# -------------------------
# Constantes et configuration
# -------------------------
INI_FILE = os.path.join(os.path.dirname(__file__), "3D_Printer_3mf_Workflow.ini")
PLATEAU_X, PLATEAU_Y, PLATEAU_Z = 240, 240, 0

MAX_OLD_BACKUPS = 2 # nb de sauvegarde

DEBUG = False
DEBUGPIPE = False

def is_running_in_flatpak():
    return platform.system() == "Linux" and (
        bool(os.environ.get("FLATPAK_ID"))
        or os.environ.get("container") == "flatpak"
        or os.path.exists("/.flatpak-info")
    )

def can_use_flatpak_spawn():
    return is_running_in_flatpak() and shutil.which("flatpak-spawn") is not None

def is_command_like_slicer_path(slicer_path):
    return bool(slicer_path) and slicer_path.strip().startswith(("flatpak run", "snap run"))

def split_command_line(command):
    try:
        return shlex.split(command.strip())
    except Exception:
        return None

def build_slicer_launch_command(slicer_path, fc_3mf):
    if is_command_like_slicer_path(slicer_path):
        cmd = split_command_line(slicer_path)
        if not cmd:
            raise ValueError(f"Invalid slicer command: {slicer_path}")

        if slicer_path.strip().startswith("flatpak run"):
            if "--file-forwarding" not in cmd:
                cmd = cmd[:2] + ["--file-forwarding"] + cmd[2:]
            cmd.extend(["@@", fc_3mf, "@@"])
        else:
            cmd.append(fc_3mf)
    else:
        cmd = [slicer_path, fc_3mf]

    if can_use_flatpak_spawn():
        cmd = ["flatpak-spawn", "--host"] + cmd

    return cmd

def host_path_exists(path):
    if not path or not can_use_flatpak_spawn():
        return False

    try:
        result = subprocess.run(
            ["flatpak-spawn", "--host", "test", "-e", path],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        return result.returncode == 0
    except Exception:
        return False

def is_valid_slicer_entry(slicer_path):
    if not slicer_path:
        return False

    if is_command_like_slicer_path(slicer_path):
        return split_command_line(slicer_path) is not None

    # Un fichier de pièce (3MF choisi par erreur avec le mauvais « Parcourir… »,
    # par exemple) n'est pas un programme
    ext = os.path.splitext(slicer_path.strip())[1].lower()
    if ext in (".3mf", ".stl", ".obj", ".step", ".stp", ".fcstd", ".gcode", ".amf"):
        return False
    if platform.system() == "Windows" and ext not in (".exe", ".bat", ".cmd", ".com"):
        return False

    if can_use_flatpak_spawn():
        return host_path_exists(slicer_path) or os.path.exists(slicer_path)

    return os.path.exists(slicer_path)

if platform.system() == "Windows":
    DEFAULT_SLICER_EXE = r"C:\Program Files\QIDIStudio\qidi-studio.exe"
elif platform.system() == "Linux":
    DEFAULT_SLICER_EXE = "/usr/bin/qidi-studio"
else:
    DEFAULT_SLICER_EXE = ""

DEFAULT_LINEAR_DEFLECTION = 0.05
DEFAULT_ANGULAR_DEGREES = 3
DEFAULT_ANGULAR_DEFLECTION = DEFAULT_ANGULAR_DEGREES * math.pi / 180.0

