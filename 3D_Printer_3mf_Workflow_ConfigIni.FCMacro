def get_user_language():
    try:
        locale = FreeCADGui.getLocale().lower()
        if locale.startswith("fr"):
            return "fr"
        return "en"
    except:
        return "en"

def tr(key):
    lang = get_user_language()
    return TRANSLATIONS.get(lang, TRANSLATIONS["en"]).get(key, key)

# -------------------------
# Fonctions INI
# -------------------------
def load_extra_commands_from_ini(path=INI_FILE):
    cfg = configparser.ConfigParser()
    try:
        cfg.read(path, encoding="utf-8")
        if "extra_commands" in cfg and "EXTRA_COMMANDS" in cfg["extra_commands"]:
            return ast.literal_eval(cfg["extra_commands"]["EXTRA_COMMANDS"])
    except:
        pass
    return []

def save_extra_commands_to_ini(commands, path=INI_FILE):
    cfg = configparser.ConfigParser()
    if os.path.exists(path):
        cfg.read(path, encoding="utf-8")
    if "extra_commands" not in cfg:
        cfg["extra_commands"] = {}
    cfg["extra_commands"]["EXTRA_COMMANDS"] = str(commands)
    with open(path, "w", encoding="utf-8") as f:
        cfg.write(f)

# -------------------------
# Boîte de dialogue
# -------------------------
def show_extra_commands_dialog():
    dialog = QtGui.QDialog()
    dialog.setWindowTitle(tr("dialog_title"))
    dialog.resize(900, 500)

    layout = QtGui.QVBoxLayout()

    table = QtGui.QTableWidget()
    table.setColumnCount(4)
    table.setWordWrap(True)



    table.setHorizontalHeaderLabels([
        tr("col_command"),
        tr("col_label"),
        tr("col_delay"),
        tr("col_default")
    ])
    # Tooltips sur les en-têtes (Qt4-compatible)
    table.horizontalHeaderItem(0).setToolTip(tr("hint_command"))
    table.horizontalHeaderItem(1).setToolTip(tr("hint_label"))
    table.horizontalHeaderItem(2).setToolTip(tr("hint_delay"))
    table.horizontalHeaderItem(3).setToolTip(tr("hint_default"))

    header = table.horizontalHeader()
    header.setResizeMode(0, QtGui.QHeaderView.Stretch)  # Commande = flexible
    header.setResizeMode(1, QtGui.QHeaderView.Interactive)  # Label redimensionnable
    header.setResizeMode(2, QtGui.QHeaderView.ResizeToContents)
    header.setResizeMode(3, QtGui.QHeaderView.ResizeToContents)

    # Permettre de redimensionner la hauteur des lignes
    table.verticalHeader().setResizeMode(QtGui.QHeaderView.Interactive)

    EXTRA_COMMANDS = load_extra_commands_from_ini(INI_FILE)
    for cmd, label, delay, default in EXTRA_COMMANDS:
        row = table.rowCount()
        table.insertRow(row)

        # Commande multi-lignes
        item_cmd = QtGui.QTableWidgetItem(" ".join(cmd))
        item_cmd.setFlags(item_cmd.flags() | QtCore.Qt.ItemIsEditable)
        table.setItem(row, 0, item_cmd)

        # Label multi-lignes
        item_label = QtGui.QTableWidgetItem(label)
        item_label.setFlags(item_label.flags() | QtCore.Qt.ItemIsEditable)
        table.setItem(row, 1, item_label)

        # Délai
        item_delay = QtGui.QTableWidgetItem(str(delay))
        item_delay.setFlags(item_delay.flags() | QtCore.Qt.ItemIsEditable)
        table.setItem(row, 2, item_delay)

        # Checkbox
        chk = QtGui.QCheckBox()
        chk.setChecked(default)
        table.setCellWidget(row, 3, chk)

    table.resizeRowsToContents()
    # Agrandir la colonne Label (colonne 1)
    table.setColumnWidth(1, table.columnWidth(1) * 2)
    layout.addWidget(table)

    # Boutons Ajouter / Supprimer
    btn_add = QtGui.QPushButton(tr("btn_add"))
    btn_del = QtGui.QPushButton(tr("btn_del"))
    h_btns = QtGui.QHBoxLayout()
    h_btns.addWidget(btn_add)
    h_btns.addWidget(btn_del)
    layout.addLayout(h_btns)

    def add_row():
        row = table.rowCount()
        table.insertRow(row)

        item_cmd = QtGui.QTableWidgetItem("")
        item_cmd.setFlags(item_cmd.flags() | QtCore.Qt.ItemIsEditable)
        table.setItem(row, 0, item_cmd)

        item_label = QtGui.QTableWidgetItem(tr("new_program"))
        item_label.setFlags(item_label.flags() | QtCore.Qt.ItemIsEditable)
        table.setItem(row, 1, item_label)

        item_delay = QtGui.QTableWidgetItem("0")
        item_delay.setFlags(item_delay.flags() | QtCore.Qt.ItemIsEditable)
        table.setItem(row, 2, item_delay)

        chk = QtGui.QCheckBox()
        chk.setChecked(False)
        table.setCellWidget(row, 3, chk)

        table.resizeRowsToContents()

    def del_row():
        row = table.currentRow()
        if row >= 0:
            table.removeRow(row)

    btn_add.clicked.connect(add_row)
    btn_del.clicked.connect(del_row)

    # Boutons OK / Annuler
    btns = QtGui.QDialogButtonBox(QtGui.QDialogButtonBox.Ok | QtGui.QDialogButtonBox.Cancel)
    layout.addWidget(btns)
    dialog.setLayout(layout)

    def save():
        new_cmds = []
        for row in range(table.rowCount()):
            cmd_str = table.item(row, 0).text().strip()
            label = table.item(row, 1).text().strip()
            delay = int(table.item(row, 2).text().strip())
            chk = table.cellWidget(row, 3)
            default = chk.isChecked()
            if cmd_str:
                new_cmds.append((cmd_str.split(), label, delay, default))
        save_extra_commands_to_ini(new_cmds)
        dialog.accept()

    btns.accepted.connect(save)
    btns.rejected.connect(dialog.reject)
    dialog.exec()

# -------------------------
# Universal launch (FreeCAD)
# -------------------------
if __name__ == "__main__":
    show_extra_commands_dialog()
