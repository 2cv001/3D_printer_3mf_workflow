def cfgini_language():
    try:
        locale = FreeCADGui.getLocale().lower()
        if locale.startswith("fr") or "french" in locale:
            return "fr"
        if locale.startswith("de") or "german" in locale:
            return "de"
        return "en"
    except Exception:
        return "en"


def cfgini_tr(key):
    lang = cfgini_language()
    text = cfgini_TRANSLATIONS.get(lang, cfgini_TRANSLATIONS["en"]).get(key, key)
    if key == "hint_command":
        text += cfgini_PLACEHOLDERS.get(lang, cfgini_PLACEHOLDERS["en"])
    return text


# -------------------------
# Découpage d'une ligne de commande
# -------------------------
def cfgini_split_command(text, windows=None):
    """
    Découpe une ligne de commande en liste d'arguments.
    Windows : séparation sur les espaces, les guillemets doubles regroupent et sont
    retirés, les « \\ » des chemins restent tels quels (\\" donne un guillemet).
    Ailleurs : règles du shell (shlex).
    """
    if windows is None:
        windows = (os.name == "nt")
    text = text.strip()
    if not windows:
        return shlex.split(text)
    parts, current, in_quotes, has_token = [], [], False, False
    i = 0
    while i < len(text):
        c = text[i]
        if c == "\\" and i + 1 < len(text) and text[i + 1] == '"':
            current.append('"')
            has_token = True
            i += 2
            continue
        if c == '"':
            in_quotes = not in_quotes
            has_token = True
        elif c.isspace() and not in_quotes:
            if has_token:
                parts.append("".join(current))
                current, has_token = [], False
        else:
            current.append(c)
            has_token = True
        i += 1
    if in_quotes:
        raise ValueError('"')
    if has_token:
        parts.append("".join(current))
    return parts


def cfgini_join_command(parts, windows=None):
    """Inverse de cfgini_split_command : remet des guillemets là où il en faut."""
    if windows is None:
        windows = (os.name == "nt")
    # Un argument avec une variable (%EXPORT%…) est aussi remis entre guillemets :
    # elle sera remplacée par un chemin qui peut contenir des espaces.
    has_var = lambda p: re.search(r"%[A-Z]+%", p) is not None
    if not windows:
        # (shlex ne traite que \ et " entre guillemets doubles : pas de shell, donc
        # $ et ` restent tels quels)
        return " ".join('"' + p.replace("\\", "\\\\").replace('"', '\\"') + '"'
                        if has_var(p) and "'" not in p else shlex.quote(p)
                        for p in map(str, parts))
    out = []
    for p in parts:
        p = str(p)
        if p == "" or any(ch.isspace() for ch in p) or '"' in p or has_var(p):
            out.append('"' + p.replace('"', '\\"') + '"')
        else:
            out.append(p)
    return " ".join(out)


def cfgini_parse_delay(text):
    """« 2 », « 2.5 », « 2,5 » → nombre de secondes ≥ 0 ; vide → 0 ; sinon ValueError."""
    text = text.strip().replace(",", ".")
    if not text:
        return 0
    value = float(text)
    if value < 0 or value != value:
        raise ValueError(text)
    return int(value) if value == int(value) else value


# -------------------------
# Fonctions INI
# -------------------------
def cfgini_load_commands(path=None):
    """Commandes de la section [extra_commands]. Lève une exception si le fichier est illisible."""
    path = path or cfgini_INI_FILE
    if not os.path.exists(path):
        return []
    cfg = configparser.ConfigParser(interpolation=None)
    cfg.read(path, encoding="utf-8")
    if "extra_commands" not in cfg or "EXTRA_COMMANDS" not in cfg["extra_commands"]:
        return []
    commands = ast.literal_eval(cfg["extra_commands"]["EXTRA_COMMANDS"])
    result = []
    for entry in commands:
        cmd, label, delay, default = entry
        if isinstance(cmd, str):
            cmd = cfgini_split_command(cmd)
        result.append((list(cmd), str(label), delay, bool(default)))
    return result


def cfgini_save_commands(commands, path=None):
    """
    Réécrit seulement la section [extra_commands] ; le reste du fichier
    (réglages, commentaires) est gardé tel quel.
    """
    path = path or cfgini_INI_FILE
    lines = []
    if os.path.exists(path):
        with open(path, "r", encoding="utf-8") as f:
            lines = f.readlines()

    body = "[\n" + "".join(f"    {tuple(c)!r},\n" for c in commands) + "    ]"
    section = ["[extra_commands]\n", "EXTRA_COMMANDS = " + body + "\n"]

    new_lines, in_extra, written = [], False, False
    for line in lines:
        stripped = line.strip()
        # En-tête de section : non indenté (une ligne indentée continue la valeur)
        if line[:1] == "[" and stripped.endswith("]"):
            if stripped.lower() == "[extra_commands]":
                in_extra = True
                if not written:
                    new_lines.extend(section)
                    written = True
                continue
            if in_extra:
                new_lines.append("\n")
            in_extra = False
        if not in_extra:
            new_lines.append(line)
    if not written:
        if new_lines and not new_lines[-1].endswith("\n"):
            new_lines[-1] += "\n"
        if new_lines and new_lines[-1].strip():
            new_lines.append("\n")
        new_lines.extend(section)

    # Vérification : le fichier obtenu doit se relire à l'identique
    check = configparser.ConfigParser(interpolation=None)
    check.read_string("".join(new_lines))
    if ast.literal_eval(check["extra_commands"]["EXTRA_COMMANDS"]) != [tuple(c) for c in commands]:
        raise ValueError("EXTRA_COMMANDS")

    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.writelines(new_lines)
    os.replace(tmp, path)


# -------------------------
# Boîte de dialogue
# -------------------------
def cfgini_parent_window():
    w = QtGui.QApplication.activeWindow()
    if w is None and FreeCADGui is not None:
        try:
            w = FreeCADGui.getMainWindow()
        except Exception:
            w = None
    return w


def show_extra_commands_dialog(parent=None, path=None):
    """Ouvre la fenêtre. Renvoie True si les commandes ont été enregistrées."""
    path = path or cfgini_INI_FILE
    tr = cfgini_tr
    if parent is None:
        parent = cfgini_parent_window()

    try:
        commands = cfgini_load_commands(path)
    except Exception as e:
        QtGui.QMessageBox.warning(parent, tr("error_title"),
                                  tr("error_read").format(path=path, error=e))
        return False

    dialog = QtGui.QDialog(parent)
    dialog.setWindowTitle(tr("dialog_title"))
    dialog.resize(900, 500)

    layout = QtGui.QVBoxLayout()

    table = QtGui.QTableWidget()
    table.setColumnCount(4)
    table.setWordWrap(True)

    table.setHorizontalHeaderLabels([
        tr("col_command"),
        tr("col_label"),
        tr("col_delay"),
        tr("col_default")
    ])
    # Tooltips sur les en-têtes (Qt4-compatible)
    table.horizontalHeaderItem(0).setToolTip(tr("hint_command"))
    table.horizontalHeaderItem(1).setToolTip(tr("hint_label"))
    table.horizontalHeaderItem(2).setToolTip(tr("hint_delay"))
    table.horizontalHeaderItem(3).setToolTip(tr("hint_default"))

    header = table.horizontalHeader()
    header.setResizeMode(0, QtGui.QHeaderView.Stretch)  # Commande = flexible
    header.setResizeMode(1, QtGui.QHeaderView.Interactive)  # Label redimensionnable
    header.setResizeMode(2, QtGui.QHeaderView.ResizeToContents)
    header.setResizeMode(3, QtGui.QHeaderView.ResizeToContents)

    # Permettre de redimensionner la hauteur des lignes
    table.verticalHeader().setResizeMode(QtGui.QHeaderView.Interactive)

    def add_row(cmd_text="", label=None, delay=0, default=False):
        row = table.rowCount()
        table.insertRow(row)

        item_cmd = QtGui.QTableWidgetItem(cmd_text)
        item_cmd.setFlags(item_cmd.flags() | QtCore.Qt.ItemIsEditable)
        item_cmd.setToolTip(tr("hint_command"))
        table.setItem(row, 0, item_cmd)

        item_label = QtGui.QTableWidgetItem(tr("new_program") if label is None else label)
        item_label.setFlags(item_label.flags() | QtCore.Qt.ItemIsEditable)
        table.setItem(row, 1, item_label)

        item_delay = QtGui.QTableWidgetItem(str(delay))
        item_delay.setFlags(item_delay.flags() | QtCore.Qt.ItemIsEditable)
        table.setItem(row, 2, item_delay)

        chk = QtGui.QCheckBox()
        chk.setChecked(bool(default))
        table.setCellWidget(row, 3, chk)

        table.resizeRowsToContents()
        return row

    for cmd, label, delay, default in commands:
        add_row(cfgini_join_command(cmd), label, delay, default)

    # Agrandir la colonne Label (colonne 1)
    table.setColumnWidth(1, table.columnWidth(1) * 2)
    layout.addWidget(table)

    # Boutons Ajouter / Supprimer
    btn_add = QtGui.QPushButton(tr("btn_add"))
    btn_del = QtGui.QPushButton(tr("btn_del"))
    h_btns = QtGui.QHBoxLayout()
    h_btns.addWidget(btn_add)
    h_btns.addWidget(btn_del)
    layout.addLayout(h_btns)

    def on_add():
        row = add_row()
        table.setCurrentCell(row, 0)
        table.editItem(table.item(row, 0))

    def del_row():
        row = table.currentRow()
        if row >= 0:
            table.removeRow(row)

    btn_add.clicked.connect(on_add)
    btn_del.clicked.connect(del_row)

    # Boutons OK / Annuler
    btns = QtGui.QDialogButtonBox(QtGui.QDialogButtonBox.Ok | QtGui.QDialogButtonBox.Cancel)
    layout.addWidget(btns)
    dialog.setLayout(layout)

    def cell_text(row, col):
        item = table.item(row, col)
        return item.text().strip() if item is not None else ""

    def fail(row, col, message):
        table.setCurrentCell(row, col)
        QtGui.QMessageBox.warning(dialog, tr("error_title"), message)

    def save():
        new_cmds = []
        for row in range(table.rowCount()):
            cmd_str = cell_text(row, 0)
            if not cmd_str:
                continue
            try:
                cmd = cfgini_split_command(cmd_str)
            except ValueError as e:
                fail(row, 0, tr("error_command").format(row=row + 1, error=e))
                return
            try:
                delay = cfgini_parse_delay(cell_text(row, 2))
            except ValueError:
                fail(row, 2, tr("error_delay").format(row=row + 1, value=cell_text(row, 2)))
                return
            chk = table.cellWidget(row, 3)
            default = chk.isChecked() if chk is not None else False
            if cmd:
                new_cmds.append((cmd, cell_text(row, 1), delay, default))
        try:
            cfgini_save_commands(new_cmds, path)
        except Exception as e:
            QtGui.QMessageBox.warning(dialog, tr("error_title"),
                                      tr("error_write").format(path=path, error=e))
            return
        dialog.accept()

    btns.accepted.connect(save)
    btns.rejected.connect(dialog.reject)
    return dialog.exec() == QtGui.QDialog.Accepted


# -------------------------
# Universal launch (FreeCAD)
# -------------------------
if __name__ == "__main__":
    show_extra_commands_dialog()
