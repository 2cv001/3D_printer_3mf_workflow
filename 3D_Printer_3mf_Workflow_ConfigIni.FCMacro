# Fenêtre de saisie des commandes utilisateur de la macro 3D_Printer_3mf_Workflow
# (section [extra_commands] du fichier 3D_Printer_3mf_Workflow.ini).
#
# Tous les noms globaux commencent par « cfgini_ » : la macro principale (anciennes
# versions) exécute ce fichier dans son propre espace de noms, il ne faut rien y écraser.
import os, sys, re, configparser, ast, shlex, shutil, subprocess, time, html
from PySide import QtGui, QtCore
try:
    import FreeCADGui
except ImportError:
    FreeCADGui = None

