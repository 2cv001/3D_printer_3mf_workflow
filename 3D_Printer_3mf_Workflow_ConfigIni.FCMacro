def cfgini_language():
    try:
        locale = FreeCADGui.getLocale().lower()
        if locale.startswith("fr") or "french" in locale:
            return "fr"
        if locale.startswith("de") or "german" in locale:
            return "de"
        return "en"
    except Exception:
        return "en"


def cfgini_tr(key):
    lang = cfgini_language()
    texts = dict(cfgini_TRANSLATIONS["en"], **cfgini_EDITOR_TEXTS["en"])
    texts.update(cfgini_TRANSLATIONS.get(lang, {}))
    texts.update(cfgini_EDITOR_TEXTS.get(lang, {}))
    text = texts.get(key, key)
    if key == "hint_command":
        text += cfgini_PLACEHOLDERS.get(lang, cfgini_PLACEHOLDERS["en"])
    return text


# -------------------------
# Découpage d'une ligne de commande
# -------------------------
def cfgini_split_command(text, windows=None):
    """
    Découpe une ligne de commande en liste d'arguments.
    Windows : séparation sur les espaces, les guillemets doubles regroupent et sont
    retirés, les « \\ » des chemins restent tels quels (\\" donne un guillemet).
    Ailleurs : règles du shell (shlex).
    """
    if windows is None:
        windows = (os.name == "nt")
    text = text.strip()
    if not windows:
        return shlex.split(text)
    parts, current, in_quotes, has_token = [], [], False, False
    i = 0
    while i < len(text):
        c = text[i]
        if c == "\\" and i + 1 < len(text) and text[i + 1] == '"':
            current.append('"')
            has_token = True
            i += 2
            continue
        if c == '"':
            in_quotes = not in_quotes
            has_token = True
        elif c.isspace() and not in_quotes:
            if has_token:
                parts.append("".join(current))
                current, has_token = [], False
        else:
            current.append(c)
            has_token = True
        i += 1
    if in_quotes:
        raise ValueError('"')
    if has_token:
        parts.append("".join(current))
    return parts


def cfgini_join_command(parts, windows=None):
    """Inverse de cfgini_split_command : remet des guillemets là où il en faut."""
    if windows is None:
        windows = (os.name == "nt")
    # Un argument avec une variable (%EXPORT%…) est aussi remis entre guillemets :
    # elle sera remplacée par un chemin qui peut contenir des espaces.
    has_var = lambda p: re.search(r"%[A-Z]+%", p) is not None
    if not windows:
        # (shlex ne traite que \ et " entre guillemets doubles : pas de shell, donc
        # $ et ` restent tels quels)
        return " ".join('"' + p.replace("\\", "\\\\").replace('"', '\\"') + '"'
                        if has_var(p) and "'" not in p else shlex.quote(p)
                        for p in map(str, parts))
    out = []
    for p in parts:
        p = str(p)
        if p == "" or any(ch.isspace() for ch in p) or '"' in p or has_var(p):
            out.append('"' + p.replace('"', '\\"') + '"')
        else:
            out.append(p)
    return " ".join(out)


def cfgini_parse_delay(text):
    """« 2 », « 2.5 », « 2,5 » → nombre de secondes ≥ 0 ; vide → 0 ; sinon ValueError."""
    text = text.strip().replace(",", ".")
    if not text:
        return 0
    value = float(text)
    if value < 0 or value != value:
        raise ValueError(text)
    return int(value) if value == int(value) else value


# -------------------------
# Aide à la saisie : chemins, vérification, modèles, test
# -------------------------
cfgini_VARIABLES = ("%PROJECT%", "%PROJECTDIR%", "%PROJECTNAME%", "%EXPORT%", "%EXPORTNAME%")

# Commandes internes de l'invite de commandes Windows (pas des programmes)
cfgini_WINDOWS_BUILTINS = {
    "assoc", "call", "cd", "chdir", "cls", "copy", "date", "del", "dir", "echo", "erase",
    "for", "ftype", "if", "md", "mkdir", "mklink", "move", "path", "pause", "popd",
    "pushd", "rd", "ren", "rename", "rmdir", "set", "start", "time", "title", "type",
    "ver", "vol",
}
cfgini_SHELL_OPERATORS = {">", ">>", "<", "|", "||", "&", "&&", "2>", "2>&1", ";"}


def cfgini_context():
    """
    Valeurs des variables pour l'aperçu et le test : celles transmises par la macro
    principale (CFGINI_CONTEXT, bouton ⚙️), sinon le document actif, sinon un exemple.
    Renvoie (dictionnaire des variables, True si ce sont des chemins d'exemple).
    """
    ctx = globals().get("CFGINI_CONTEXT") or {}
    project, export, example = ctx.get("PROJECT"), ctx.get("EXPORT"), False
    if not project:
        try:
            import FreeCAD
            doc = FreeCAD.ActiveDocument
            if doc is not None and doc.FileName:
                project = os.path.splitext(doc.FileName)[0]
        except Exception:
            pass
    if not project:
        project = os.path.join(os.path.expanduser("~"), "Project")
        example = True
    if not export:
        export = os.path.join(os.path.dirname(project), "Body")
        example = True
    # Même normalisation que la macro principale (FreeCAD donne « D:/… » sous Windows)
    project, export = os.path.normpath(project), os.path.normpath(export)
    return {
        "%PROJECT%": project,
        "%PROJECTDIR%": os.path.dirname(project),
        "%PROJECTNAME%": os.path.basename(project),
        "%EXPORT%": export,
        "%EXPORTNAME%": os.path.basename(export),
    }, example


def cfgini_substitute(parts, values):
    """Même remplacement que la macro principale au lancement (run_extra_commands)."""
    return [p.replace("%PROJECT%", values["%PROJECT%"])
             .replace("%PROJECTDIR%", values["%PROJECTDIR%"])
             .replace("%PROJECTNAME%", values["%PROJECTNAME%"])
             .replace("%EXPORT%", values["%EXPORT%"])
             .replace("%EXPORTNAME%", values["%EXPORTNAME%"])
            for p in parts]


def cfgini_find_program(program):
    """Chemin du programme, ou None s'il est introuvable."""
    if os.path.dirname(program):
        return program if os.path.isfile(program) else None
    return shutil.which(program)


def cfgini_analyze(text, values, windows=None, before=False):
    """
    Analyse une ligne de commande. Renvoie un dict :
      parts : arguments après remplacement des variables (None si la ligne est vide ou invalide)
      program, program_path
      errors, warnings : listes de messages (texte simple)
    """
    if windows is None:
        windows = (os.name == "nt")
    tr = cfgini_tr
    result = {"parts": None, "program": None, "program_path": None, "errors": [], "warnings": []}
    if not text.strip():
        return result
    try:
        raw = cfgini_split_command(text, windows=windows)
    except ValueError:
        result["errors"].append(tr("chk_unclosed"))
        return result
    if not raw:
        return result
    parts = cfgini_substitute(raw, values)
    result["parts"] = parts
    program = parts[0]
    result["program"] = program
    name = os.path.basename(program).lower()

    found = cfgini_find_program(program)
    result["program_path"] = found
    if found is None:
        if windows and name in cfgini_WINDOWS_BUILTINS:
            result["errors"].append(tr("chk_builtin").format(word=program))
        elif not re.search(r"<[^<>\"]+>", program):
            result["errors"].append(tr("chk_not_found").format(prog=program))

    if before and "%EXPORT" in text:
        result["warnings"].append(tr("chk_before_export"))

    placeholders = sorted(set(re.findall(r"<[^<>\"\s]+>", text)))
    if placeholders:
        result["warnings"].append(tr("chk_placeholder").format(items=", ".join(placeholders)))

    if windows:
        for arg in raw[1:]:
            if len(arg) >= 2 and arg.startswith("'") and arg.endswith("'"):
                result["warnings"].append(tr("chk_single_quotes").format(arg=arg))
                break

    shells = ("cmd", "cmd.exe", "powershell", "powershell.exe", "pwsh", "pwsh.exe", "sh", "bash")
    if name not in shells:
        for arg in raw[1:]:
            if arg in cfgini_SHELL_OPERATORS:
                result["warnings"].append(tr("chk_shell_op").format(op=arg))
                break

    for var in sorted(set(re.findall(r"%[A-Za-z_][A-Za-z0-9_]*%", text))):
        if var in cfgini_VARIABLES:
            continue
        if name in ("cmd", "cmd.exe") and var.strip("%").upper() in (k.upper() for k in os.environ):
            continue  # variable d'environnement, remplacée par cmd
        result["warnings"].append(tr("chk_unknown_var").format(var=var))
    return result


def cfgini_check_html(analysis, example):
    """Texte (HTML) affiché sous la ligne de commande."""
    tr = cfgini_tr
    esc = html.escape
    lines = []
    for msg in analysis["errors"]:
        lines.append(f"<span style='color:#c62828'>✗ {esc(msg)}</span>")
    if analysis["program_path"]:
        prog, path = analysis["program"], analysis["program_path"]
        # Chemin complet déjà tapé : inutile de l'afficher deux fois
        same = os.path.normcase(os.path.normpath(prog)) == os.path.normcase(os.path.normpath(path))
        text = (tr("chk_program_found").format(path=path) if same
                else tr("chk_program").format(prog=prog, path=path))
        lines.append("<span style='color:#2e7d32'>✓ " + esc(text) + "</span>")
    for msg in analysis["warnings"]:
        lines.append(f"<span style='color:#b26a00'>⚠ {esc(msg)}</span>")
    parts = analysis["parts"]
    if parts:
        if len(parts) > 1:
            shown = " &nbsp;│&nbsp; ".join(f"<code>{esc(p)}</code>" for p in parts[1:])
            lines.append(f"{esc(tr('chk_params'))} : {shown}")
        else:
            lines.append(esc(tr("chk_no_params")))
    if parts and example:
        lines.append(f"<i>{esc(tr('chk_example'))}</i>")
    return "<br>".join(lines)


def cfgini_templates(windows=None):
    """Modèles : (clé du libellé, commande). Commande None = choisir un programme."""
    if windows is None:
        windows = (os.name == "nt")
    tr = cfgini_tr
    ph = lambda key: "<" + tr(key) + ">"
    sep = "\\" if windows else "/"
    if windows:
        copy_cmd = f'cmd /c copy /y "%EXPORT%.3mf" "{ph("ph_folder")}\\%EXPORTNAME%.3mf"'
        open_cmd = 'explorer "%PROJECTDIR%"'
        python = "python"
    else:
        copy_cmd = f'cp "%EXPORT%.3mf" "{ph("ph_folder")}/%EXPORTNAME%.3mf"'
        open_cmd = ('open' if sys.platform == "darwin" else 'xdg-open') + ' "%PROJECTDIR%"'
        python = "python3"
    plug, printer = ph("ph_ip_plug"), ph("ph_ip_printer")
    return [
        ("tpl_program", None),
        ("tpl_copy", copy_cmd),
        ("tpl_open_folder", open_cmd),
        ("tpl_web", f'curl --fail "http://{ph("ph_server")}/api?job=%PROJECTNAME%"'),
        ("tpl_shelly1", f'curl --fail "http://{plug}/relay/0?turn=on"'),
        ("tpl_shelly1_pw", f'curl --fail -u {ph("ph_user")}:{ph("ph_password")} '
                           f'"http://{plug}/relay/0?turn=on"'),
        ("tpl_shelly2", f'curl --fail "http://{plug}/rpc/Switch.Set?id=0&on=true"'),
        ("tpl_shelly2_pw", f'curl --fail --anyauth -u admin:{ph("ph_password")} '
                           f'"http://{plug}/rpc/Switch.Set?id=0&on=true"'),
        ("tpl_shelly_cloud", f'curl --fail -X POST "https://{ph("ph_cloud_server")}/device/relay/control" '
                             f'-d "channel=0&turn=on&id={ph("ph_device_id")}&auth_key={ph("ph_api_key")}"'),
        ("tpl_home_assistant", f'curl --fail -X POST -H "Authorization: Bearer {ph("ph_token")}" '
                               f'-H "Content-Type: application/json" '
                               f'-d "{{\\"entity_id\\":\\"switch.{ph("ph_entity")}\\"}}" '
                               f'"http://{ph("ph_ha")}:8123/api/services/switch/turn_on"'),
        ("tpl_jeedom", f'curl --fail "http://{ph("ph_jeedom")}/core/api/jeeApi.php'
                       f'?apikey={ph("ph_api_key")}&type=cmd&id={ph("ph_cmd_id")}"'),
        ("tpl_klipper", f'curl --fail -X POST "http://{printer}:7125/printer/gcode/script?script=M140%20S60"'),
        ("tpl_python", f'{python} "%PROJECTDIR%{sep}{ph("ph_script")}.py" "%EXPORT%.3mf"'),
    ]


def cfgini_run_test(parts, timeout=3.0):
    """
    Lance la commande comme la macro (sans interpréteur) et attend au plus `timeout` s.
    Renvoie ("done", code), ("running", None) ou ("error", message).
    """
    try:
        proc = subprocess.Popen(parts)
    except Exception as e:
        return ("error", str(e))
    end = time.time() + timeout
    while time.time() < end:
        code = proc.poll()
        if code is not None:
            return ("done", code)
        app = QtGui.QApplication.instance()
        if app is not None:
            app.processEvents()
        time.sleep(0.05)
    return ("running", None)


def cfgini_test_message(parts, outcome, timeout=3.0):
    tr = cfgini_tr
    kind, value = outcome
    name = os.path.splitext(os.path.basename(parts[0]))[0].lower()
    if kind == "error":
        return False, tr("test_error").format(error=value)
    if kind == "running":
        return True, tr("test_still").format(sec=f"{timeout:g}")
    if value == 0:
        return True, tr("test_ok")
    if name == "explorer":  # l'Explorateur répond 1 même quand il a ouvert le dossier
        return True, tr("test_ok_explorer")
    msg = tr("test_fail").format(code=value)
    if name == "curl" and f"curl_{value}" in cfgini_EDITOR_TEXTS["en"]:
        msg += " (" + tr(f"curl_{value}") + ")"
    return False, msg


# -------------------------
# Fonctions INI
# -------------------------
def cfgini_load_commands(path=None):
    """
    Commandes de la section [extra_commands] : liste de (cmd, label, delay, default, before),
    celles « avant l'export » (clé EXTRA_COMMANDS_BEFORE) en premier.
    Lève une exception si le fichier est illisible.
    """
    path = path or cfgini_INI_FILE
    if not os.path.exists(path):
        return []
    cfg = configparser.ConfigParser(interpolation=None)
    cfg.read(path, encoding="utf-8")
    if "extra_commands" not in cfg:
        return []
    section = cfg["extra_commands"]
    result = []
    for key, before in (("EXTRA_COMMANDS_BEFORE", True), ("EXTRA_COMMANDS", False)):
        if key not in section:
            continue
        for entry in ast.literal_eval(section[key]):
            cmd, label, delay, default = entry[:4]
            if isinstance(cmd, str):
                cmd = cfgini_split_command(cmd)
            result.append((list(cmd), str(label), delay, bool(default), before))
    return result


def cfgini_save_commands(commands, path=None):
    """
    Réécrit seulement la section [extra_commands] ; le reste du fichier
    (réglages, commentaires) est gardé tel quel.
    commands : (cmd, label, delay, default[, before]). Les commandes « avant l'export »
    vont dans EXTRA_COMMANDS_BEFORE, que les anciennes versions de la macro ignorent.
    """
    path = path or cfgini_INI_FILE
    lines = []
    if os.path.exists(path):
        with open(path, "r", encoding="utf-8") as f:
            lines = f.readlines()

    after = [tuple(c[:4]) for c in commands if not (len(c) > 4 and c[4])]
    before = [tuple(c[:4]) for c in commands if len(c) > 4 and c[4]]
    body = lambda cmds: "[\n" + "".join(f"    {c!r},\n" for c in cmds) + "    ]"
    section = ["[extra_commands]\n"]
    if before:
        section.append("EXTRA_COMMANDS_BEFORE = " + body(before) + "\n")
    section.append("EXTRA_COMMANDS = " + body(after) + "\n")

    new_lines, in_extra, written = [], False, False
    for line in lines:
        stripped = line.strip()
        # En-tête de section : non indenté (une ligne indentée continue la valeur)
        if line[:1] == "[" and stripped.endswith("]"):
            if stripped.lower() == "[extra_commands]":
                in_extra = True
                if not written:
                    new_lines.extend(section)
                    written = True
                continue
            if in_extra:
                new_lines.append("\n")
            in_extra = False
        if not in_extra:
            new_lines.append(line)
    if not written:
        if new_lines and not new_lines[-1].endswith("\n"):
            new_lines[-1] += "\n"
        if new_lines and new_lines[-1].strip():
            new_lines.append("\n")
        new_lines.extend(section)

    # Vérification : le fichier obtenu doit se relire à l'identique
    check = configparser.ConfigParser(interpolation=None)
    check.read_string("".join(new_lines))
    sec = check["extra_commands"]
    if (ast.literal_eval(sec["EXTRA_COMMANDS"]) != after
            or ast.literal_eval(sec.get("EXTRA_COMMANDS_BEFORE", "[]")) != before):
        raise ValueError("EXTRA_COMMANDS")

    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.writelines(new_lines)
    os.replace(tmp, path)


# -------------------------
# Boîte de dialogue
# -------------------------
def cfgini_parent_window():
    w = QtGui.QApplication.activeWindow()
    if w is None and FreeCADGui is not None:
        try:
            w = FreeCADGui.getMainWindow()
        except Exception:
            w = None
    return w


def show_extra_commands_dialog(parent=None, path=None):
    """Ouvre la fenêtre. Renvoie True si les commandes ont été enregistrées."""
    path = path or cfgini_INI_FILE
    tr = cfgini_tr
    if parent is None:
        parent = cfgini_parent_window()

    try:
        commands = cfgini_load_commands(path)
    except Exception as e:
        QtGui.QMessageBox.warning(parent, tr("error_title"),
                                  tr("error_read").format(path=path, error=e))
        return False

    dialog = QtGui.QDialog(parent)
    dialog.setWindowTitle(tr("dialog_title"))
    dialog.resize(900, 650)

    layout = QtGui.QVBoxLayout()

    table = QtGui.QTableWidget()
    table.setColumnCount(5)
    table.setWordWrap(True)

    table.setHorizontalHeaderLabels([
        tr("col_command"),
        tr("col_label"),
        tr("col_delay"),
        tr("col_default"),
        tr("col_before"),
    ])
    # Tooltips sur les en-têtes (Qt4-compatible)
    table.horizontalHeaderItem(0).setToolTip(tr("hint_command"))
    table.horizontalHeaderItem(1).setToolTip(tr("hint_label"))
    table.horizontalHeaderItem(2).setToolTip(tr("hint_delay"))
    table.horizontalHeaderItem(3).setToolTip(tr("hint_default"))
    table.horizontalHeaderItem(4).setToolTip(tr("hint_before"))

    header = table.horizontalHeader()
    header.setResizeMode(0, QtGui.QHeaderView.Stretch)  # Commande = flexible
    header.setResizeMode(1, QtGui.QHeaderView.Interactive)  # Label redimensionnable
    header.setResizeMode(2, QtGui.QHeaderView.ResizeToContents)
    header.setResizeMode(3, QtGui.QHeaderView.ResizeToContents)
    header.setResizeMode(4, QtGui.QHeaderView.ResizeToContents)

    # Permettre de redimensionner la hauteur des lignes
    table.verticalHeader().setResizeMode(QtGui.QHeaderView.Interactive)

    # Rappel de la vérification quand on coche « Avant l'export » (définie plus bas)
    hooks = {"check": lambda: None}

    def add_row(cmd_text="", label=None, delay=0, default=False, before=False):
        row = table.rowCount()
        table.insertRow(row)

        item_cmd = QtGui.QTableWidgetItem(cmd_text)
        item_cmd.setFlags(item_cmd.flags() | QtCore.Qt.ItemIsEditable)
        item_cmd.setToolTip(tr("hint_command"))
        table.setItem(row, 0, item_cmd)

        item_label = QtGui.QTableWidgetItem(tr("new_program") if label is None else label)
        item_label.setFlags(item_label.flags() | QtCore.Qt.ItemIsEditable)
        table.setItem(row, 1, item_label)

        item_delay = QtGui.QTableWidgetItem(str(delay))
        item_delay.setFlags(item_delay.flags() | QtCore.Qt.ItemIsEditable)
        table.setItem(row, 2, item_delay)

        chk = QtGui.QCheckBox()
        chk.setChecked(bool(default))
        table.setCellWidget(row, 3, chk)

        chk_before = QtGui.QCheckBox()
        chk_before.setChecked(bool(before))
        chk_before.setToolTip(tr("hint_before"))
        chk_before.toggled.connect(lambda *a: hooks["check"]())
        table.setCellWidget(row, 4, chk_before)

        table.resizeRowsToContents()
        return row

    for cmd, label, delay, default, before in commands:
        add_row(cfgini_join_command(cmd), label, delay, default, before)

    # Agrandir la colonne Label (colonne 1)
    table.setColumnWidth(1, table.columnWidth(1) * 2)
    layout.addWidget(table)

    # Boutons Ajouter un modèle / Ajouter sans modèle / Supprimer
    btn_add = QtGui.QPushButton(tr("btn_add"))
    btn_templates = QtGui.QPushButton(tr("btn_templates"))
    menu_templates = QtGui.QMenu(btn_templates)
    btn_templates.setMenu(menu_templates)
    btn_del = QtGui.QPushButton(tr("btn_del"))
    h_btns = QtGui.QHBoxLayout()
    h_btns.addWidget(btn_templates)   # en premier : le plus utile pour démarrer
    h_btns.addWidget(btn_add)
    h_btns.addWidget(btn_del)
    layout.addLayout(h_btns)

    # --- Zone d'édition de la commande de la ligne sélectionnée ---
    values, example = cfgini_context()
    editor = QtGui.QGroupBox(tr("editor_title"))
    ed_layout = QtGui.QVBoxLayout(editor)
    cmd_edit = QtGui.QLineEdit()
    cmd_edit.setPlaceholderText(tr("cmd_placeholder"))
    cmd_edit.setToolTip(tr("hint_command"))
    ed_layout.addWidget(cmd_edit)
    h_tools = QtGui.QHBoxLayout()
    btn_browse = QtGui.QPushButton(tr("btn_browse"))
    btn_browse.setToolTip(tr("hint_browse"))
    btn_vars = QtGui.QPushButton(tr("btn_vars"))
    menu_vars = QtGui.QMenu(btn_vars)
    btn_vars.setMenu(menu_vars)
    btn_test = QtGui.QPushButton(tr("btn_test"))
    btn_test.setToolTip(tr("hint_test"))
    h_tools.addWidget(btn_browse)
    h_tools.addWidget(btn_vars)
    h_tools.addStretch(1)
    h_tools.addWidget(btn_test)
    ed_layout.addLayout(h_tools)
    lbl_check = QtGui.QLabel()
    lbl_check.setTextFormat(QtCore.Qt.RichText)
    lbl_check.setWordWrap(True)
    lbl_check.setTextInteractionFlags(QtCore.Qt.TextSelectableByMouse)
    lbl_check.setMinimumHeight(60)
    lbl_check.setAlignment(QtCore.Qt.AlignTop | QtCore.Qt.AlignLeft)
    ed_layout.addWidget(lbl_check)
    lbl_test = QtGui.QLabel()
    lbl_test.setWordWrap(True)
    ed_layout.addWidget(lbl_test)
    layout.addWidget(editor)

    syncing = [False]

    def current_row():
        r = table.currentRow()
        return r if 0 <= r < table.rowCount() else -1

    def row_is_before(r):
        w = table.cellWidget(r, 4) if r >= 0 else None
        return bool(w is not None and w.isChecked())

    def update_check():
        analysis = cfgini_analyze(cmd_edit.text(), values, before=row_is_before(current_row()))
        lbl_check.setText(cfgini_check_html(analysis, example))
        btn_test.setEnabled(current_row() >= 0 and bool(analysis["parts"]))
        return analysis

    hooks["check"] = update_check

    def load_editor():
        r = current_row()
        for w in (cmd_edit, btn_browse, btn_vars):
            w.setEnabled(r >= 0)
        syncing[0] = True
        item = table.item(r, 0) if r >= 0 else None
        cmd_edit.setText(item.text() if item is not None else "")
        syncing[0] = False
        lbl_test.setText("")
        update_check()

    def on_edit(text):
        if syncing[0]:
            return
        r = current_row()
        if r >= 0 and table.item(r, 0) is not None:
            syncing[0] = True
            table.item(r, 0).setText(text)
            syncing[0] = False
        lbl_test.setText("")
        update_check()

    def on_item_changed(item):
        if syncing[0] or item.column() != 0 or item.row() != current_row():
            return
        syncing[0] = True
        cmd_edit.setText(item.text())
        syncing[0] = False
        update_check()

    table.currentCellChanged.connect(lambda *a: load_editor())
    table.itemChanged.connect(on_item_changed)
    cmd_edit.textChanged.connect(on_edit)

    def select_row(row):
        table.setCurrentCell(row, 0)
        load_editor()
        cmd_edit.setFocus()

    def on_add():
        select_row(add_row())

    def del_row():
        row = table.currentRow()
        if row >= 0:
            table.removeRow(row)
        load_editor()

    def set_label_if_default(row, label):
        item = table.item(row, 1)
        if item is not None and item.text().strip() in ("", tr("new_program")):
            item.setText(label)

    def choose_file():
        result = QtGui.QFileDialog.getOpenFileName(dialog, tr("btn_browse"))
        return result[0] if isinstance(result, (tuple, list)) else result

    def in_first_token(before):
        """Vrai si `before` (texte avant le curseur) n'a pas encore dépassé le programme."""
        in_q = False
        for c in before.lstrip():
            if c == '"':
                in_q = not in_q
            elif c.isspace() and not in_q:
                return False
        return True

    def insert_text(text, quote=True):
        """Insère au curseur ; entre guillemets si on est en début d'argument."""
        pos = cmd_edit.cursorPosition()
        current = cmd_edit.text()
        inside_quotes = current[:pos].count('"') % 2 == 1
        at_token_start = pos == 0 or current[pos - 1].isspace()
        # Collé au programme ou à un argument entre guillemets : il faut un espace
        # (au milieu d'un argument, ex. « job=| » dans une adresse, on colle)
        if not at_token_start and not inside_quotes and (
                current[pos - 1] == '"' or in_first_token(current[:pos])):
            text_prefix = " "
            at_token_start = True
        else:
            text_prefix = ""
        if quote and not inside_quotes and at_token_start:
            text = '"' + text + '"'
        if pos < len(current) and at_token_start and not current[pos].isspace() and not inside_quotes:
            text += " "
        cmd_edit.insert(text_prefix + text)
        cmd_edit.setFocus()

    def on_browse():
        path_chosen = choose_file()
        if not path_chosen:
            return
        path_chosen = os.path.normpath(path_chosen)
        r = current_row()
        if not cmd_edit.text().strip():
            cmd_edit.setText(cfgini_join_command([path_chosen]))
            if r >= 0:
                set_label_if_default(r, os.path.splitext(os.path.basename(path_chosen))[0])
        else:
            current = cmd_edit.text()
            if cmd_edit.cursorPosition() == len(current) and not current.endswith(" "):
                cmd_edit.setText(current + " ")
                cmd_edit.setCursorPosition(len(current) + 1)
            insert_text(path_chosen, quote=any(c.isspace() for c in path_chosen))

    def apply_template(label_key, command):
        if command is None:  # « Lancer un programme… »
            path_chosen = choose_file()
            if not path_chosen:
                return
            path_chosen = os.path.normpath(path_chosen)
            row = add_row(cfgini_join_command([path_chosen]),
                          os.path.splitext(os.path.basename(path_chosen))[0])
            select_row(row)
            return
        row = add_row(command, tr(label_key))
        select_row(row)
        # Sélection de la première partie à remplacer : il suffit de taper
        m = re.search(r"<[^<>\"\s]+>", command)
        if m:
            cmd_edit.setSelection(m.start(), m.end() - m.start())

    for label_key, command in cfgini_templates():
        action = menu_templates.addAction(tr(label_key))
        action.triggered.connect(lambda checked=False, k=label_key, c=command: apply_template(k, c))

    for var, key in (("%EXPORT%.3mf", "var_export3mf"), ("%EXPORT%", "var_export"),
                     ("%EXPORTNAME%", "var_exportname"), ("%PROJECT%", "var_project"),
                     ("%PROJECTDIR%", "var_projectdir"), ("%PROJECTNAME%", "var_projectname")):
        sample = cfgini_substitute([var], values)[0]
        action = menu_vars.addAction(f"{var}   —   {tr(key)}")
        action.setToolTip(sample)
        action.setStatusTip(sample)
        action.triggered.connect(lambda checked=False, v=var: insert_text(v))

    def on_test():
        analysis = update_check()
        parts = analysis["parts"]
        if not parts:
            return
        if analysis["errors"]:
            QtGui.QMessageBox.warning(dialog, tr("test_title"), tr("test_blocked").format(
                errors="\n".join(analysis["errors"])))
            return
        shown = subprocess.list2cmdline(parts) if os.name == "nt" else \
            " ".join(shlex.quote(p) for p in parts)
        answer = QtGui.QMessageBox.question(
            dialog, tr("test_title"), tr("test_confirm").format(cmd=shown),
            QtGui.QMessageBox.Yes | QtGui.QMessageBox.No, QtGui.QMessageBox.No)
        if answer != QtGui.QMessageBox.Yes:
            return
        btn_test.setEnabled(False)
        lbl_test.setStyleSheet("")
        lbl_test.setText(tr("test_running"))
        try:
            ok, msg = cfgini_test_message(parts, cfgini_run_test(parts))
        finally:
            btn_test.setEnabled(True)
        lbl_test.setStyleSheet("color:#2e7d32" if ok else "color:#c62828")
        lbl_test.setText(("✓ " if ok else "✗ ") + msg)

    btn_add.clicked.connect(on_add)
    btn_del.clicked.connect(del_row)
    btn_browse.clicked.connect(on_browse)
    btn_test.clicked.connect(on_test)
    if table.rowCount():
        table.setCurrentCell(0, 0)
    load_editor()

    # Boutons OK / Annuler
    btns = QtGui.QDialogButtonBox(QtGui.QDialogButtonBox.Ok | QtGui.QDialogButtonBox.Cancel)
    layout.addWidget(btns)
    dialog.setLayout(layout)

    def cell_text(row, col):
        item = table.item(row, col)
        return item.text().strip() if item is not None else ""

    def fail(row, col, message):
        table.setCurrentCell(row, col)
        QtGui.QMessageBox.warning(dialog, tr("error_title"), message)

    def save():
        new_cmds = []
        for row in range(table.rowCount()):
            cmd_str = cell_text(row, 0)
            if not cmd_str:
                continue
            try:
                cmd = cfgini_split_command(cmd_str)
            except ValueError as e:
                fail(row, 0, tr("error_command").format(row=row + 1, error=e))
                return
            try:
                delay = cfgini_parse_delay(cell_text(row, 2))
            except ValueError:
                fail(row, 2, tr("error_delay").format(row=row + 1, value=cell_text(row, 2)))
                return
            chk = table.cellWidget(row, 3)
            default = chk.isChecked() if chk is not None else False
            if cmd:
                new_cmds.append((cmd, cell_text(row, 1), delay, default, row_is_before(row)))
        try:
            cfgini_save_commands(new_cmds, path)
        except Exception as e:
            QtGui.QMessageBox.warning(dialog, tr("error_title"),
                                      tr("error_write").format(path=path, error=e))
            return
        dialog.accept()

    btns.accepted.connect(save)
    btns.rejected.connect(dialog.reject)
    return dialog.exec() == QtGui.QDialog.Accepted


# -------------------------
# Universal launch (FreeCAD)
# -------------------------
if __name__ == "__main__":
    show_extra_commands_dialog()
